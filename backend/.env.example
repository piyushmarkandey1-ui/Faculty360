# AcadLens FastAPI Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # NEVER expose to browser
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Scholar Live API Extraction (Choose at least one)
# Option 1: SerpApi Google Scholar Author API (Recommended for reliability)
SERPAPI_API_KEY=your-serpapi-key

# Option 2: Apify Actor API Token
APIFY_API_TOKEN=your-apify-token
APIFY_GOOGLE_SCHOLAR_ACTOR_ID=biscience/google-scholar-scraper

# AI Insights
GEMINI_API_KEY=your-gemini-api-key

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

