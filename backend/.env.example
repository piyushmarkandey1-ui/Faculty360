# AcadLens Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Required for real AI insights on the Assessment and Faculty Profile pages.
# Without this, the system falls back to deterministic mock insights automatically.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-google-gemini-api-key>

# ── Google Scholar / Research Connectors (optional) ──────────────────────────
SERPAPI_API_KEY=
APIFY_API_TOKEN=
